# MIDAS application

# Optional override — if unset, apps read ../.midas/database.json after `midas-db init` from database/
# DATABASE_URL=postgresql://postgres@127.0.0.1:5432/midas
REPORTING_CURRENCY=CAD

# LiteLLM / model configuration
MIDAS_DEFAULT_MODEL=openai/gpt-4o-mini
MIDAS_FALLBACK_MODELS=
MIDAS_TEMPERATURE=0.2
MIDAS_TIMEOUT_SECONDS=60

# Provider credentials (set at least one for LLM integration tests)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Future LiteLLM Proxy (not used during bootstrap)
# LITELLM_PROXY_BASE_URL=http://localhost:4000
# LITELLM_PROXY_API_KEY=
